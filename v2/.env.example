# Copy to v2/.env. Values here are public examples, never production credentials.
MBRAND_DEPLOYMENT_ID=m-brand
ZEROBRAND_PORT=18830
ZEROBRAND_PUBLIC_ORIGIN=https://localhost:8443
ZEROBRAND_PG_URL=postgres://mbrand:replace_with_your_database_password@127.0.0.1:5432/mbrand
ZEROBRAND_ADMIN_USER=admin
ZEROBRAND_ADMIN_PASS=replace_with_a_unique_strong_password
ZEROBRAND_ADMIN_2FA=1
ZEROBRAND_ENV=development

# OpenAI-compatible image and text endpoints; use your own credentials.
ZEROBRAND_IMG_BASE_URL=
ZEROBRAND_IMG_API_KEY=
ZEROBRAND_IMG_MODEL=
ZEROBRAND_TEXT_BASE_URL=
ZEROBRAND_TEXT_API_KEY=
ZEROBRAND_TEXT_MODEL=

# Invitation mail. Sender must be one plain verified email, without display name.
ZEROBRAND_SMTP_HOST=
ZEROBRAND_SMTP_PORT=465
ZEROBRAND_SMTP_USER=
ZEROBRAND_SMTP_PASS=
ZEROBRAND_SMTP_FROM=
# Alternatively, use Resend HTTP API (leave SMTP host empty).
ZEROBRAND_RESEND_API_KEY=

# Real payment is disabled without your own merchant credentials.
WXPAY_MOCK=0
WXPAY_APPID=
WXPAY_MCHID=
WXPAY_SERIAL=
WXPAY_APIV3_KEY=
WXPAY_KEY_PATH=
WXPAY_PLATFORM_KEY_PATH=
WXPAY_PLATFORM_SERIAL=
# Empty derives /api/pay/notify from ZEROBRAND_PUBLIC_ORIGIN.
WXPAY_NOTIFY_URL=
